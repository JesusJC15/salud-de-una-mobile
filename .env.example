# ── API ───────────────────────────────────────────────────────────────────────
# Backend base URL including /v1 prefix
# Android emulator: use 10.0.2.2 instead of localhost
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Get from Auth0 dashboard → Applications → SaludDeUna Mobile
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-mobile-native-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.salud-de-una.com

# ── Environment ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
