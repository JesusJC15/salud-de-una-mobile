# ── API ───────────────────────────────────────────────────────────────────────
# Backend desplegado en AWS ECS/Fargate
#
# IMPORTANTE: el APK usa HTTP (no HTTPS) porque el ALB tiene certificado
# autofirmado que Android rechaza. HTTP funciona en React Native mobile
# sin restricciones — la limitación isSecureContext es solo de WebAPIs del browser.
#
# El puerto 80 del ALB tiene las mismas reglas de routing que el 443:
#   /v1/*       → backend ECS
#   /socket.io/* → backend ECS (WebSocket)
#   default     → web ECS
EXPO_PUBLIC_API_URL=http://salud-de-una-dev-alb-279246547.us-east-1.elb.amazonaws.com/v1

# Desarrollo local con emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/v1

# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Auth0 → Applications → SaludDeUna Mobile (Native)
EXPO_PUBLIC_AUTH0_DOMAIN=salud-de-una.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=i5R0nnGVqe9NptWc0yPzbc2FHonj9P8B
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.salud-de-una.com

# ── Environment ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
